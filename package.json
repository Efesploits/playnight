{
  "name": "playnight",
  "productName": "Play Night",
  "version": "1.4.0",
  "description": "Play Night - Arkadaslarinla oyun gecesi. 101 Okey, Ciz Babacim, UNO, Papaz Kacti, Satranc ve M3RANT.",
  "author": "Play Night",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "prepare-assets": "node scripts/make-icon.js && node scripts/copy-vendor.js && node scripts/sync-m3rant.js",
    "start": "npm run prepare-assets && electron .",
    "dev": "electron .",
    "dist": "npm run prepare-assets && electron-builder --win portable nsis --publish never",
    "dist:portable": "npm run prepare-assets && electron-builder --win portable --publish never",
    "publish": "node scripts/publish.js",
    "release": "npm run dist && npm run publish",
    "test:engine": "node tests/engine.test.js",
    "smoke:m3rant": "electron scripts/smoke-m3rant.js",
    "smoke:launch": "electron scripts/smoke-launch.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "peerjs": "^1.5.4",
    "three": "^0.149.0"
  },
  "build": {
    "appId": "com.playnight.app",
    "productName": "Play Night",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PlayNight-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Play Night",
      "artifactName": "PlayNight-${version}-setup.exe"
    },
    "compression": "maximum"
  }
}
